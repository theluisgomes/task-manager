# ─── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://taskmanager:taskmanager@localhost:3306/taskmanager
JWT_SECRET=change-me-to-a-long-random-string

# ─── OAuth (Google and/or Microsoft) ────────────────────────────────────────
# Leave unset for local dev login at /api/dev/login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# First admin user — set after first OAuth login (format: google:xxx or microsoft:xxx)
OWNER_OPEN_ID=

# ─── Email (invites & notifications) ─────────────────────────────────────────
EMAIL_FROM=Task Manager <noreply@yourcompany.com>

# Option A: Resend
RESEND_API_KEY=

# Option B: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Optional ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
VITE_APP_ID=task-manager-pro

# Payment due reminders (cron → POST /api/cron/payment-reminders)
PAYMENT_REMINDER_EMAIL=rodrigo@wisemetrics.in
CRON_SECRET=

# Object storage (Forge/S3) — local filesystem used when unset
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
