# ─── Task Manager — Google Cloud deploy config ────────────────────────────────
# Copy this file to scripts/deploy.env and fill in the values, then run:
#   ./scripts/deploy-gcp.sh all
#
# scripts/deploy.env is gitignored — it holds secrets, never commit it.

# ─── Project & region (required) ──────────────────────────────────────────────
# Globally unique. If "already in use", the project exists — just set PROJECT_ID to it.
PROJECT_ID=your-gcp-project-id
REGION=us-central1
SERVICE_NAME=task-manager

# Billing account to link to a NEWLY created project.
# Find it with:  gcloud billing accounts list
# Leave blank if the project already has billing enabled.
BILLING_ACCOUNT=

# ─── Cloud SQL (required) ─────────────────────────────────────────────────────
SQL_INSTANCE=task-manager-db
SQL_TIER=db-f1-micro
DB_NAME=taskmanager
DB_USER=taskmanager
# Pick strong passwords. The root password is only used at instance creation.
# Use single quotes when setting via gcloud CLI if password contains % or @.
DB_PASSWORD=CHANGE-ME-strong-app-password
DB_ROOT_PASSWORD=CHANGE-ME-strong-root-password

# ─── App identity (required) ──────────────────────────────────────────────────
VITE_APP_ID=task-manager-pro
# Leave JWT_SECRET blank to auto-generate one (openssl rand -base64 32).
JWT_SECRET=

# ─── Google OAuth (required for production login) ─────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials
# Web application client. Redirect URI is set AFTER first deploy (script prints it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin — set AFTER first login (format: google:1234567890).
# Must be the exact openId from whoami — NOT a password.
# Run  ./scripts/deploy-gcp.sh whoami  to look it up, then fill this in and redeploy.
OWNER_OPEN_ID=

# ─── Custom domain (optional) ─────────────────────────────────────────────────
# Your public HTTPS URL after mapping the domain in Cloud Run + GoDaddy DNS.
# Example: https://tasks.yourdomain.com  (no trailing slash)
# When set, deploy uses this for OAUTH_REDIRECT_BASE_URL instead of *.run.app.
CUSTOM_DOMAIN=

# ─── Email (optional — invites & notifications) ───────────────────────────────
EMAIL_FROM=
RESEND_API_KEY=
